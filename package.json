{
  "name": "biova",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo typecheck",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "bun run --filter @biova/database db:generate",
    "db:migrate": "bun run --filter @biova/database db:migrate",
    "db:studio": "bun run --filter @biova/database db:studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
