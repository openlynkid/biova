{
  "name": "biova",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env run turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "check": "bun run typecheck && bun run lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "bun run --filter @biova/database db:generate",
    "db:migrate": "bun --env-file=.env run --filter @biova/database db:migrate",
    "db:studio": "bun run --filter @biova/database db:studio",
    "clean": "turbo clean && rm -rf node_modules",
    "db:seed": "bun --env-file=.env run scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
