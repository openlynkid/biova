NODE_ENV=development
# Public site origin. Absolute URLs (canonical tags, sitemap.xml, the sitemap line
# in robots.txt) are built from this, never from the request host, so set it to
# the real production domain when deployed.
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biova
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API and the auth
# endpoints (Better Auth `trustedOrigins`).
CORS_ORIGINS=http://localhost:3000
# Hosts allowed to reach the auth endpoints. Defaults to localhost, 127.0.0.1 and
# *.all-hands.dev in development; set it explicitly for a custom domain.
# BETTER_AUTH_ALLOWED_HOSTS=biova.example

# Payments. When MIDTRANS_SERVER_KEY is set, Midtrans is used and its server key
# signs and verifies webhook notifications. Leave it empty for local development:
# a fake provider is used instead, gated by PAYMENT_FAKE_SECRET.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# PAYMENT_FAKE_SECRET=local-dev-fake-secret

# Digital delivery. Uploaded product files are written under STORAGE_DIR (a local
# directory by default; point it at a mounted volume in production). Download
# links are signed with DOWNLOAD_TOKEN_SECRET and expire after
# DOWNLOAD_TOKEN_TTL_SECONDS.
STORAGE_DIR=.storage
# MAX_ASSET_BYTES=52428800
# Branding images (avatar, cover) are capped separately.
# MAX_MEDIA_BYTES=5242880
# DOWNLOAD_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# DOWNLOAD_TOKEN_TTL_SECONDS=900
